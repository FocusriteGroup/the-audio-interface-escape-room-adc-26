{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build current exercise",
      "detail": "Rebuilds whichever exercise the runner last built. Run the runner first.",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build/workshop/app"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "windows": { "problemMatcher": ["$msCompile"] }
    },
    {
      "label": "Run focused check",
      "detail": "Rebuilds the tests and runs the current exercise's focused check (cmake -P scripts/check.cmake).",
      "type": "shell",
      "command": "cmake",
      "args": ["-P", "${workspaceFolder}/scripts/check.cmake"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": ["$gcc"],
      "windows": { "problemMatcher": ["$msCompile"] }
    }
  ]
}
