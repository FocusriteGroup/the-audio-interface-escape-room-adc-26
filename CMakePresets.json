{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-debug",
      "displayName": "Core Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ESCAPE_ROOM_BUILD_APP": "OFF"
      }
    },
    {
      "name": "mission-01-debug",
      "displayName": "Mission 1 Debug",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/mission-01-debug",
      "cacheVariables": {
        "ESCAPE_ROOM_BUILD_APP": "ON",
        "ESCAPE_ROOM_MISSION": "01-test-tone"
      }
    },
    {
      "name": "app-debug",
      "displayName": "Known-good App Debug",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/app-debug",
      "cacheVariables": {
        "ESCAPE_ROOM_BUILD_APP": "ON"
      }
    },
    {
      "name": "mission-04-core-debug",
      "displayName": "Mission 4 Core Debug",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/mission-04-core-debug",
      "cacheVariables": {
        "ESCAPE_ROOM_MISSION": "04-playback-buzz"
      }
    },
    {
      "name": "mission-04-debug",
      "displayName": "Mission 4 App Debug",
      "inherits": "mission-04-core-debug",
      "binaryDir": "${sourceDir}/build/mission-04-debug",
      "cacheVariables": {
        "ESCAPE_ROOM_BUILD_APP": "ON"
      }
    },
    {
      "name": "baseline-release",
      "displayName": "Known-good Baseline Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/baseline-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ESCAPE_ROOM_BUILD_APP": "ON",
        "ESCAPE_ROOM_MISSION": "baseline"
      }
    },
    {
      "name": "mission-02-core-debug",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/mission-02-core-debug",
      "cacheVariables": { "ESCAPE_ROOM_MISSION": "02-right-channel" }
    },
    {
      "name": "mission-02-debug",
      "inherits": "mission-02-core-debug",
      "binaryDir": "${sourceDir}/build/mission-02-debug",
      "cacheVariables": { "ESCAPE_ROOM_BUILD_APP": "ON" }
    },
    {
      "name": "mission-03-core-debug",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/mission-03-core-debug",
      "cacheVariables": { "ESCAPE_ROOM_MISSION": "03-mono-playback" }
    },
    {
      "name": "mission-03-debug",
      "inherits": "mission-03-core-debug",
      "binaryDir": "${sourceDir}/build/mission-03-debug",
      "cacheVariables": { "ESCAPE_ROOM_BUILD_APP": "ON" }
    },
    {
      "name": "mission-05-core-debug",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/mission-05-core-debug",
      "cacheVariables": { "ESCAPE_ROOM_MISSION": "05-saved-setup" }
    },
    {
      "name": "mission-05-debug",
      "inherits": "mission-05-core-debug",
      "binaryDir": "${sourceDir}/build/mission-05-debug",
      "cacheVariables": { "ESCAPE_ROOM_BUILD_APP": "ON" }
    },
    {
      "name": "final-core-debug",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/final-core-debug",
      "cacheVariables": { "ESCAPE_ROOM_MISSION": "final-customer-report" }
    },
    {
      "name": "final-debug",
      "inherits": "final-core-debug",
      "binaryDir": "${sourceDir}/build/final-debug",
      "cacheVariables": { "ESCAPE_ROOM_BUILD_APP": "ON" }
    },
    {
      "name": "baseline-release-macos",
      "displayName": "Known-good Baseline Universal macOS Release",
      "inherits": "baseline-release",
      "binaryDir": "${sourceDir}/build/baseline-release-macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    },
    {
      "name": "mission-01-release",
      "displayName": "Mission 1 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mission-01-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ESCAPE_ROOM_BUILD_APP": "ON",
        "ESCAPE_ROOM_MISSION": "01-test-tone",
        "ESCAPE_ROOM_USE_START_CODE": "ON"
      }
    },
    {
      "name": "mission-01-release-macos",
      "displayName": "Mission 1 Universal macOS Release",
      "inherits": "mission-01-release",
      "binaryDir": "${sourceDir}/build/mission-01-release-macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    },
    {
      "name": "core-sanitized",
      "displayName": "Core Address/Undefined Sanitizers",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/core-sanitized",
      "cacheVariables": {
        "ESCAPE_ROOM_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "mission-02-core-debug", "configurePreset": "mission-02-core-debug" },
    { "name": "mission-02-debug", "configurePreset": "mission-02-debug" },
    { "name": "mission-03-core-debug", "configurePreset": "mission-03-core-debug" },
    { "name": "mission-03-debug", "configurePreset": "mission-03-debug" },
    { "name": "mission-05-core-debug", "configurePreset": "mission-05-core-debug" },
    { "name": "mission-05-debug", "configurePreset": "mission-05-debug" },
    { "name": "final-core-debug", "configurePreset": "final-core-debug" },
    { "name": "final-debug", "configurePreset": "final-debug" },
    {
      "name": "mission-04-core-debug",
      "configurePreset": "mission-04-core-debug"
    },
    {
      "name": "mission-04-debug",
      "configurePreset": "mission-04-debug"
    },
    {
      "name": "core-debug",
      "configurePreset": "core-debug"
    },
    {
      "name": "mission-01-debug",
      "configurePreset": "mission-01-debug"
    },
    {
      "name": "app-debug",
      "configurePreset": "app-debug"
    },
    {
      "name": "baseline-release",
      "configurePreset": "baseline-release"
    },
    {
      "name": "baseline-release-macos",
      "configurePreset": "baseline-release-macos"
    },
    {
      "name": "mission-01-release",
      "configurePreset": "mission-01-release"
    },
    {
      "name": "mission-01-release-macos",
      "configurePreset": "mission-01-release-macos"
    },
    {
      "name": "core-sanitized",
      "configurePreset": "core-sanitized"
    }
  ],
  "testPresets": [
    { "name": "mission-02-core-debug", "configurePreset": "mission-02-core-debug", "output": { "outputOnFailure": true } },
    { "name": "mission-02-debug", "configurePreset": "mission-02-debug", "output": { "outputOnFailure": true } },
    { "name": "mission-03-core-debug", "configurePreset": "mission-03-core-debug", "output": { "outputOnFailure": true } },
    { "name": "mission-03-debug", "configurePreset": "mission-03-debug", "output": { "outputOnFailure": true } },
    { "name": "mission-05-core-debug", "configurePreset": "mission-05-core-debug", "output": { "outputOnFailure": true } },
    { "name": "mission-05-debug", "configurePreset": "mission-05-debug", "output": { "outputOnFailure": true } },
    { "name": "final-core-debug", "configurePreset": "final-core-debug", "output": { "outputOnFailure": true } },
    { "name": "final-debug", "configurePreset": "final-debug", "output": { "outputOnFailure": true } },
    {
      "name": "mission-04-core-debug",
