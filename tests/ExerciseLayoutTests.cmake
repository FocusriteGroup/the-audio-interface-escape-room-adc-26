cmake_minimum_required(VERSION 3.28)

include("${WORKSHOP_ROOT}/scripts/working-set.cmake")
set(expected_files ${escape_room_working_files})
list(SORT expected_files)
set(exercise_missions 01-test-tone 02-right-channel 03-mono-playback 04-playback-buzz
    05-saved-setup final-customer-report)
foreach(mission IN LISTS exercise_missions)
    set(start "${WORKSHOP_ROOT}/audio-core/.exercises/${mission}")
    if(NOT IS_DIRECTORY "${start}")
        # The pre-workshop attendee release ships Exercise 1 only; the others are
        # added later. Exercise 1 and the exercise being built must be present.
        if(mission STREQUAL "01-test-tone" OR (mission STREQUAL ACTIVE_MISSION AND NOT USE_SOLUTION))
            message(FATAL_ERROR "audio-core/.exercises/${mission} is missing")
        endif()
        continue()
    endif()
    file(GLOB actual_files RELATIVE "${start}" "${start}/*.cpp")
    list(SORT actual_files)
    if(NOT actual_files STREQUAL expected_files)
        message(FATAL_ERROR "audio-core/.exercises/${mission} must contain the complete processing working set: ${expected_files}; found ${actual_files}")
    endif()
endforeach()

set(source_directory "${WORKSHOP_ROOT}/audio-core/.answers")
if(NOT USE_SOLUTION AND ACTIVE_MISSION IN_LIST exercise_missions)
    if(USE_START_CODE)
        set(source_directory "${WORKSHOP_ROOT}/audio-core/.exercises/${ACTIVE_MISSION}")
    else()
        set(source_directory "${WORKSHOP_ROOT}/exercise")
        escape_room_working_set_mission("${WORKSHOP_ROOT}" held_mission)
        if(NOT held_mission STREQUAL ACTIVE_MISSION)
            message(FATAL_ERROR "exercise/ holds '${held_mission}', not ${ACTIVE_MISSION}")
        endif()
    endif()
endif()

string(REPLACE "|" ";" compiled_sources "${COMPILED_SOURCES}")
set(absolute_sources)
foreach(source IN LISTS compiled_sources)
    get_filename_component(absolute_source "${source}" ABSOLUTE
        BASE_DIR "${WORKSHOP_ROOT}/audio-core")
    list(APPEND absolute_sources "${absolute_source}")
endforeach()
foreach(filename IN LISTS expected_files)
    set(expected_source "${source_directory}/${filename}")
    if(NOT expected_source IN_LIST absolute_sources)
        message(FATAL_ERROR "${ACTIVE_MISSION} must compile ${expected_source}")
    endif()
endforeach()
message(STATUS "Exercise working sets and active source selection verified")
